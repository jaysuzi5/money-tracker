# Local development — copy to .env and fill in
SECRET_KEY=dev-insecure-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,money-tracker.home.arpa

# Postgres on the k8s cluster (NodePort for local dev), or omit to use sqlite
DATABASE_URL=postgres://jcurtis:PASSWORD@192.168.86.201:30004/money_tracker

# Fernet key for encrypting connection credentials at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# SimpleFIN Bridge access URL (exchange your one-time setup token for this once).
SIMPLEFIN_ACCESS_URL=

CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://money-tracker.home.arpa

OTEL_SERVICE_NAME=money-tracker
OTLP_ENDPOINT=
